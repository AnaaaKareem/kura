SECRET_KEY="your-secret-key-here"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=kura
DATABASE_USER=kura-admin
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432
# ClamAV settings (optional in development; defaults to localhost/clamav)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_REQUIRED=False
# Vault is disabled by default when DEBUG=True; enable it to encrypt authenticator seeds.
# VAULT_ENABLED=False stores seeds unencrypted and is for development only.
# In Docker, Django reads its AppRole login from secrets/vault_role_id.txt and secrets/vault_secret_id.txt (written by ./kura.sh vault-init).
VAULT_URL=https://localhost:8200
VAULT_CA_CERT=certs/internal/ca.crt
VAULT_ENABLED=False
# Log in to PostgreSQL with temporary users from Vault (Docker only; keep False locally).
VAULT_DATABASE_CREDENTIALS=False
# Links in emails are built from this address (never from the visitor's Host header).
SITE_URL=http://localhost:8000
# Docker: the public host name visitors type.
# Its DNS record points at the VM, and nginx serves it directly on port 443. Compose uses it for ALLOWED_HOSTS and SITE_URL.
# KURA_PUBLIC_HOSTNAME=kura.example.edu

# Email: production sends through Gmail SMTP (smtp.gmail.com:587, STARTTLS).
# The address is not secret. The Gmail app password is read from Vault KV
# (secret gmail-app-password) at runtime, not from a Docker secret file.
KURA_GMAIL_ADDRESS=kuralmsedu@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kuralmsedu@gmail.com
