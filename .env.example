SECRET_KEY="your-secret-key-here"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=kura
DATABASE_USER=kura-admin
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432
# ClamAV settings (optional in development; defaults to localhost/clamav)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_REQUIRED=False
# HashiCorp Vault settings (optional in development; defaults to disabled when DEBUG=True)
# With VAULT_ENABLED=False, authenticator seeds are stored unencrypted (development only).
# In Docker, Django reads its AppRole login from secrets/vault_role_id.txt and
# secrets/vault_secret_id.txt (written by docker/vault/init-vault.sh).
VAULT_URL=https://localhost:8200
VAULT_CA_CERT=certs/internal/ca.crt
VAULT_ENABLED=False
# Log in to PostgreSQL with temporary users from Vault (Docker only; keep False locally).
VAULT_DATABASE_CREDENTIALS=False
# Links in emails are built from this address (never from the visitor's Host header).
SITE_URL=http://localhost:8000
# Self-hosted NetBird server (docker/netbird/README.md). 127.0.0.1 = only this
# computer can reach it; set 0.0.0.0 on the VM so admins on the LAN can.
NETBIRD_BIND_ADDRESS=127.0.0.1
