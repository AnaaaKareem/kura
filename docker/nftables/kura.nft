#!/usr/sbin/nft -f

# Kura's host-only firewall.
# Do not apply until SSH from an allowlisted address and console recovery access have been verified, and the operator has scheduled the rollback in README.md.
# Replace only this table, never the whole ruleset or Docker's forwarding rules.
# Reloading recreates the CrowdSec sets; the bouncer must repopulate them.
table inet kura_host
delete table inet kura_host
table inet kura_host {
    # The host bouncer maintains these temporary IPv4 and IPv6 ban entries.
    set crowdsec_blacklists { type ipv4_addr; flags timeout; }
    set crowdsec6_blacklists { type ipv6_addr; flags timeout; }

    # Addresses allowed to open SSH. 192.0.2.10 is a documentation placeholder:
    # replace it with the admin's public or campus address (or subnet, for example 203.0.113.0/28) before applying, or nobody can log in over SSH.
    set admin_allowlist { type ipv4_addr; flags interval; elements = { 192.0.2.10 } }
    # Optional IPv6 admin addresses, for example: elements = { 2001:db8::10 }
    set admin_allowlist6 { type ipv6_addr; flags interval; }

    # Web egress allowlist for INFRA-26–31.
# web runs on the egress network at 172.28.60.10 and may reach only:
#   - api.pwnedpasswords.com:443 (HaveIBeenPwned breach check)
#   - smtp.gmail.com:587 (Gmail SMTP, STARTTLS)
#   - 1.1.1.1:53 (DNS resolver)
# Everything else on the internet is dropped.
# flags timeout lets ./kura.sh egress-refresh add resolved addresses that expire after 2 hours.
# The DNS resolver is fixed (the same address as dns: in docker-compose.yml), so it is listed here without a timeout.
set egress_smtp { type ipv4_addr; flags timeout; }
set egress_hibp { type ipv4_addr; flags timeout; }
set egress_dns { type ipv4_addr; flags timeout; elements = { 1.1.1.1 } }

chain web_egress {
    ip daddr @egress_smtp tcp dport 587 accept
    ip daddr @egress_hibp tcp dport 443 accept
    ip daddr @egress_dns udp dport 53 accept
    ip daddr @egress_dns tcp dport 53 accept
    counter drop
}

# Filter traffic addressed to the host itself.
    chain input {
        type filter hook input priority filter; policy drop;

        # Local processes and replies to established connections must work.
        iif "lo" accept
        ct state invalid drop
        ct state established,related accept

        # Block new host connections from addresses banned by CrowdSec.
        ip saddr @crowdsec_blacklists drop
        ip6 saddr @crowdsec6_blacklists drop

        # IPv6 neighbour discovery is needed for normal network operation.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
        # Permit limited IPv4 ping for diagnosis without opening TCP ports.
        ip protocol icmp icmp type echo-request limit rate 5/second accept

        # Public web traffic: HTTPS on 443, and 80 only for nginx's redirect to HTTPS.
        # Docker forwards its published ports through the forward hook (below), not this one, so these lines document the intent and cover a host-installed web server.
        tcp dport { 80, 443 } accept

        # SSH only from the admin allowlist.
        # Grafana is reached through this SSH connection (local port forward to 127.0.0.1:3000), so no other admin port is opened.
        ip saddr @admin_allowlist tcp dport 22 accept
        ip6 saddr @admin_allowlist6 tcp dport 22 accept
    }

    # Docker sends traffic for published ports (nginx on 80 and 443) through the forward hook after rewriting the destination, so the input chain above never sees it.
    # This chain only drops addresses banned by CrowdSec, so bans also stop web clients.
    # It runs just before Docker's own rules (priority filter - 10) and accepts everything else, leaving Docker's forwarding untouched.
    chain forward {
        type filter hook forward priority filter - 10; policy accept;

        ip saddr @crowdsec_blacklists drop
        ip6 saddr @crowdsec6_blacklists drop

        # Web egress: jump to web_egress chain for traffic from the web container's egress address.
        # kura-egress is the bridge name pinned for the egress network in docker-compose.yml. Keep the two names the same.
        iifname "kura-egress" ip saddr 172.28.60.10 jump web_egress
    }
}
