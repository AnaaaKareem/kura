# ==============================================================================
# Kura's scheduled jobs. Install into ROOT's crontab on the VM:
#     sudo crontab docker/cron/kura.crontab
# (root is needed by the certificate renewal, which rewrites keys owned by
# container users). Every job runs through run-job.sh, which records its last
# success and exit code as metrics for Prometheus (alerts in WP4).
# Logs: /var/log/kura/<job>.log, rotated by docker/cron/kura.logrotate.
# ==============================================================================
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# CHANGE if Kura lives somewhere else on the VM.
KURA_DIR=/opt/kura
# Where the .prom files go (mounted read-only into Alloy, see KURA_METRICS_DIR in .env).
KURA_METRICS_DIR=/var/lib/kura-metrics

# Every minute: send queued emails, and save the application counts.
* * * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh send-emails docker compose exec -T web python manage.py send_queued_emails >> /var/log/kura/send-emails.log 2>&1
* * * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh app-metrics sh docker/cron/write-app-metrics.sh >> /var/log/kura/app-metrics.log 2>&1

# Every 5 minutes: finalize assessment attempts whose deadline has passed.
*/5 * * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh finalize-attempts docker compose exec -T web python manage.py finalize_attempts >> /var/log/kura/finalize-attempts.log 2>&1

# Every hour: queue the "due in 24 hours" reminder emails.
0 * * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh due-reminders docker compose exec -T web python manage.py queue_due_reminders >> /var/log/kura/due-reminders.log 2>&1

# Every day at 04:00: delete quarantined uploads older than 7 days (owner's choice).
0 4 * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh purge-quarantine docker compose exec -T web python manage.py purge_quarantine --days=7 >> /var/log/kura/purge-quarantine.log 2>&1

# Every Monday at 03:30: renew the internal certificates from Vault (they last
# 30 days). Vault must be unsealed. Also writes certificate expiry metrics.
30 3 * * 1 /bin/sh $KURA_DIR/docker/cron/run-job.sh cert-renewal sh certs/renew-certs-from-vault.sh >> /var/log/kura/cert-renewal.log 2>&1

# Monthly: delete expired sessions and old login records after 180 days.
# Weekly (Sunday): anonymise IP addresses older than 180 days. (Approved by the owner, 6 November 2026.)
0 5 1 * * /bin/sh $KURA_DIR/docker/cron/run-job.sh purge-retention docker compose exec -T web python manage.py purge_retention --days=180 >> /var/log/kura/purge-retention.log 2>&1
0 5 * * 0 /bin/sh $KURA_DIR/docker/cron/run-job.sh anonymize-ips docker compose exec -T web python manage.py anonymize_ips --days=180 >> /var/log/kura/anonymize-ips.log 2>&1

# Backups (pgBackRest, local encrypted repository repo1 in the db container's
# backup volume). WAL is archived continuously by PostgreSQL itself.
# Full backup every Sunday at 02:00; differential every other day at 02:00;
# a consistency check every day at 06:00.
0 2 * * 0 /bin/sh $KURA_DIR/docker/cron/run-job.sh backup-full docker compose exec -T db pgbackrest --stanza=kura --type=full backup >> /var/log/kura/backup.log 2>&1
0 2 * * 1-6 /bin/sh $KURA_DIR/docker/cron/run-job.sh backup-diff docker compose exec -T db pgbackrest --stanza=kura --type=diff backup >> /var/log/kura/backup.log 2>&1
0 6 * * * /bin/sh $KURA_DIR/docker/cron/run-job.sh backup-check docker compose exec -T db pgbackrest --stanza=kura check >> /var/log/kura/backup.log 2>&1
# Off-site copy (repo2, S3) and the Vault backup are added once the storage
# details exist (WP10 in docs/INFRASTRUCTURE_HANDOFF.md).
